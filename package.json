{
  "name": "@lichens-innovation/eslint-plugin-coding-guide",
  "version": "1.1.0",
  "description": "ESLint flat-config plugin enforcing Lichens Innovation TypeScript/React coding standards.",
  "author": "Lichens Innovation",
  "license": "MIT",
  "repository": "https://github.com/Lichens-Innovation/eslint-plugin-coding-guide",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": "24.19.0",
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:package": "npmPkgJsonLint .",
    "lint:unused": "knip",
    "lint:duplication": "jscpd src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "rimraf dist && vite build",
    "test": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0"
  },
  "dependencies": {
    "@typescript-eslint/utils": "8.71.1"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/npm": "13.2.0",
    "@types/node": "26.6.4",
    "@typescript-eslint/rule-tester": "8.71.1",
    "@vitest/coverage-v8": "4.1.11",
    "commitlint": "21.2.3",
    "eslint": "10.12.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "77.0.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "jscpd": "5.4.0",
    "knip": "6.40.0",
    "lint-staged": "17.6.0",
    "npm-package-json-lint": "11.0.0",
    "prettier": "3.9.9",
    "rimraf": "6.1.3",
    "semantic-release": "25.0.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "unplugin-dts": "1.1.2",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,cjs,mjs}": [
      "prettier --write"
    ],
    "package.json": [
      "npmPkgJsonLint",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
